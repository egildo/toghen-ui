{
  "name": "@toghen/ui",
  "version": "0.1.0",
  "description": "The design system of the Toghen Figma plugin's own screen, and Toghen's playground",
  "type": "module",
  "exports": {
    "./resolver.json": "./tokens/toghen-plugin.resolver.json",
    "./tokens/*": "./tokens/*",
    "./elements.js": "./src/elements.js",
    "./icons.js": "./src/icons.js",
    "./styles.css": "./dist/toghen-ui.css",
    "./build.mjs": "./scripts/build.mjs"
  },
  "files": [
    "tokens/",
    "src/",
    "scripts/",
    "dist/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "gallery": "node scripts/gallery.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && node scripts/check-purity.mjs"
  },
  "license": "MIT",
  "author": "Egildo Tagliareni <egildo@tagliareni.it>",
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@csstools/postcss-mixins": "1.1.0",
    "@toghen/lib": "^0.1.0",
    "@toghen/postcss": "^0.1.0",
    "@types/node": "^24.1.0",
    "geist": "1.5.1",
    "postcss": "^8.5.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/Toghen/ui.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.3"
}
